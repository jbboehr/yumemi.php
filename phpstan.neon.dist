includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
parameters:
    level: max
    paths:
        - src
        - tests
    excludePaths:
        - src/Parser/Parser.php
    strictRules:
        strictCalls: false
    ignoreErrors:
        -
            message: "#^Trait jbboehr\\\\IudexMensurarumMysteriorum\\\\Parser\\\\ParserUtils is used zero times and is not analysed\\.$#"
            path: src/Parser/ParserUtils.php
