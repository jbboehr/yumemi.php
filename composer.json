{
    "name": "jbboehr/yumemi",
    "description": "Static dimensional analysis for PHPStan, backed by a runtime unit-conversion engine for PHP.",
    "type": "library",
    "license": "AGPL-3.0-only WITH romic-exception",
    "homepage": "https://github.com/jbboehr/yumemi.php",
    "support": {
        "issues": "https://github.com/jbboehr/yumemi.php/issues",
        "source": "https://github.com/jbboehr/yumemi.php"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/jbboehr/akashi.php"
        },
        {
            "type": "vcs",
            "url": "https://github.com/jbboehr/phpbench-perfidious"
        }
    ],
    "authors": [
        {
            "name": "John Boehr",
            "email": "jbboehr@gmail.com"
        }
    ],
    "archive": {
        "exclude": [
            "/.claude",
            "/.codex",
            "/.direnv",
            "/.envrc",
            "/.github",
            "/.gitignore",
            "/.idea",
            "/.php-cs-fixer.cache",
            "/.php-cs-fixer.dist.php",
            "/.phpbench",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/.pre-commit-cache",
            "/.pre-commit-config.yaml",
            "/AGENTS.md",
            "/Makefile",
            "/assets",
            "/benchmarks",
            "/bin",
            "/build",
            "/clover.xml",
            "/composer-project.nix",
            "/composer.lock",
            "/coverage",
            "/docs/DOCTRINE-CODING-GUIDE.md",
            "/docs/DOCTRINE-IMAGE-GUIDE.md",
            "/docs/DOCTRINE-STYLE-GUIDE.md",
            "/docs/book.toml",
            "/docs/theme",
            "/flake.lock",
            "/flake.nix",
            "/infection.json5.dist",
            "/infection.phpstan.bootstrap.php",
            "/infection.phpstan.json5.dist",
            "/*.log",
            "/phpbench-perfidious.json",
            "/phpbench.json",
            "/phpstan.neon.dist",
            "/phpunit.branch.xml.dist",
            "/phpunit.xml.dist",
            "/result*",
            "/src/Catalog/PhpCatalogExporter.php",
            "/src/Catalog/Udunits2CatalogImporter.php",
            "/src/Command",
            "/tests",
            "/tmp",
            "/vendor"
        ]
    },
    "require": {
        "php": "^8.2",
        "ext-gmp": "*",
        "doctrine/lexer": "^3.0",
        "symfony/polyfill-php84": "^1.34"
    },
    "suggest": {
        "jbboehr/yumemi-apocrypha": "Provides curated unit-aware PHPStan integrations for supported third-party packages.",
        "phpstan/phpstan": "Enables the bundled Yumemi unit types extension (extension.neon; requires PHPStan 2.2.5 or later)."
    },
    "autoload": {
        "psr-4": {
            "jbboehr\\Yumemi\\": "src"
        },
        "classmap": [
            "src/Parser/Parser.php"
        ],
        "files": [
            "src/functions.php"
        ]
    },
    "require-dev": {
        "ext-dom": "*",
        "brick/varexporter": "^0.6",
        "friendsofphp/php-cs-fixer": "^3",
        "giorgiosironi/eris": "^1.1",
        "infection/infection": "^0.32.6",
        "jbboehr/akashi": "dev-master",
        "jbboehr/phpbench-perfidious": "dev-master",
        "mrsuh/php-bison-skeleton": "^1.2",
        "nikic/php-fuzzer": "^0.0.11",
        "phpbench/phpbench": "^1.7",
        "phpstan/phpstan": "^2.2.5",
        "phpstan/phpstan-phpunit": "^2.0.13",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "jbboehr\\Yumemi\\Benchmarks\\": "benchmarks",
            "jbboehr\\Yumemi\\Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress",
        "benchmark": "phpbench run --report=aggregate",
        "benchmark:perf": "phpbench run --config=phpbench-perfidious.json --report=perfidious",
        "benchmark:smoke": "phpbench run --iterations=1 --revs=1 --warmup=1 --progress=none",
        "check": [
            "@composer validate --strict",
            "@check:whitespace",
            "@cs",
            "@analyse",
            "@test"
        ],
        "check:full": [
            "@check",
            "@docs:check",
            "@benchmark:smoke",
            "@test:consumer:archive"
        ],
        "check:whitespace": "git diff --check",
        "coverage:branch": "make coverage-branch",
        "cs": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
        "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "docs": "make docs",
        "docs:check": "make docs-check",
        "docs:serve": "make docs-serve",
        "probator:unit-parser": "make probator-unit-parser",
        "generate-catalog": "make generate-catalog",
        "generate-parser": [
            "bison -S vendor/mrsuh/php-bison-skeleton/src/php-skel.m4 -o src/Parser/Parser.php src/Parser/grammar.y",
            "sed -i \"s/__DOLLAR__/$/g\" src/Parser/Parser.php"
        ],
        "infection": "infection --no-progress",
        "infection:ci": "infection --no-progress --min-msi=86 --min-covered-msi=86",
        "infection:core": "infection --no-progress --filter=src/Number/Rational.php,src/Dimension.php,src/Analyzer",
        "infection:phpstan": "infection --configuration=infection.phpstan.json5.dist --no-progress",
        "infection:phpstan:ci": "infection --configuration=infection.phpstan.json5.dist --no-progress --min-msi=85 --min-covered-msi=85",
        "infection:phpstan:core": "infection --configuration=infection.phpstan.json5.dist --no-progress --filter=src/PHPStan/InvalidUnitCallRule.php,src/PHPStan/InvalidUnitRootFunctionRule.php,src/PHPStan/NativeUnitArgumentResolver.php,src/PHPStan/UnitExpression.php,src/PHPStan/UnitExpressionAlgebra.php,src/PHPStan/UnitExpressionParseResult.php,src/PHPStan/UnitExpressionParser.php,src/PHPStan/UnitConstantIntegerType.php,src/PHPStan/UnitFactorFunctionDynamicReturnTypeExtension.php,src/PHPStan/UnitFloatType.php,src/PHPStan/UnitFunctionDynamicReturnTypeExtension.php,src/PHPStan/UnitIntegerRangeMath.php,src/PHPStan/UnitIntegerType.php,src/PHPStan/UnitIntegerTypeHelper.php,src/PHPStan/UnitMinMaxFunctionTypeResolverExtension.php,src/PHPStan/UnitOperatorTypeSpecifyingExtension.php,src/PHPStan/UnitPreservingFunctionTypeResolverExtension.php,src/PHPStan/UnitRootFunctionTypeResolverExtension.php,src/PHPStan/UnitToFunctionDynamicReturnTypeExtension.php,src/PHPStan/UnitUnaryOperatorTypeSpecifyingExtension.php,src/PHPStan/QuantityType.php,src/PHPStan/PointQuantityType.php,src/PHPStan/PointUnitExpression.php,src/PHPStan/PointUnitExpressionParseResult.php",
        "test": "phpunit --no-coverage",
        "test:coverage": "phpunit",
        "test:consumer": "make test-consumer",
        "test:consumer:archive": "make test-consumer-archive",
        "test:property": "phpunit --group property --no-coverage",
        "test:udunits2": "make test-udunits2"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    }
}
