{
    "name": "jbboehr/imm",
    "description": "Runtime unit conversion and dimensional analysis for PHP (PHPStan extension planned).",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "John Boehr",
            "email": "jbboehr@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-gmp": "*",
        "doctrine/lexer": "^3.0"
    },
    "suggest": {
        "ext-bcmath": "Enables decimal conversion output when exact integer conversion is not possible."
    },
    "bin": [
        "bin/generate-udunits2-catalog"
    ],
    "autoload": {
        "psr-4": {
            "jbboehr\\IudexMensurarumMysteriorum\\": "src"
        },
        "classmap": [
            "src/Parser/Parser.php"
        ]
    },
    "require-dev": {
        "ext-bcmath": "*",
        "ext-dom": "*",
        "brick/varexporter": "^0.6",
        "friendsofphp/php-cs-fixer": "^3",
        "mrsuh/php-bison-skeleton": "^1.2",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-phpunit": "^1.3",
        "phpstan/phpstan-strict-rules": "^1.5",
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "jbboehr\\IudexMensurarumMysteriorum\\Scripts\\": "scripts",
            "jbboehr\\IudexMensurarumMysteriorum\\Tests\\": "tests"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
        "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "generate-parser": [
            "bison -S vendor/mrsuh/php-bison-skeleton/src/php-skel.m4 -o src/Parser/Parser.php src/Parser/grammar.y",
            "sed -i \"s/__DOLLAR__/$/g\" src/Parser/Parser.php"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
