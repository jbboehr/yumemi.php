# Yumemi PHPStan extension (incremental).
# Piece 1: unit expression parsing
# Piece 2: unit_int / unit_float PHPDoc types
# Piece 3: arithmetic operator type inference (+ - * / ** % and unary +/-)
# Piece 4: unit() construction helper (dynamic return type)
# Piece 5: unit_to() conversion helper (dynamic return type)
# Piece 6: invalid unit() / unit_factor() / unit_to() call diagnostics (rule)
# Piece 7: Quantity<'...'> object type + Units::quantity() return type
# Piece 13: Quantity construction/conversion validation + native integer extraction bridges
# Piece 14: unit_factor() conversion-ratio helper (dynamic return type)
# Optional @yumemi-* tag promotion is registered separately by yumemi-tags.neon.

parameters:
    yumemi:
        registryFactory: null
        stubs: []
    # Symfony's conditional classmap stub also contains its pre-enum integer fallback. Scan the
    # native shape explicitly so PHPStan sees enum cases on every PHP version Yumemi supports.
    scanFiles:
        - stubs/RoundingMode.php

parametersSchema:
    yumemi: structure([
        registryFactory: schema(string(), nullable()),
        stubs: listOf(string()),
    ])

services:
    yumemiConfiguredUnitRegistryProvider:
        class: jbboehr\Yumemi\PHPStan\ConfiguredUnitRegistryProvider
        arguments:
            factoryClass: %yumemi.registryFactory%
        autowired: false
    yumemiUnitRegistry:
        class: jbboehr\Yumemi\Registry\UnitRegistry
        factory: @yumemiConfiguredUnitRegistryProvider::getRegistry()
        autowired: false
    yumemiUnits:
        class: jbboehr\Yumemi\Units
        arguments:
            unitRegistry: @yumemiUnitRegistry
        autowired: false
    yumemiUnitExpressionParser:
        class: jbboehr\Yumemi\PHPStan\UnitExpressionParser
        arguments:
            units: @yumemiUnits
    -
        class: jbboehr\Yumemi\PHPStan\UnitRegistryResultCacheMetaExtension
        arguments:
            registry: @yumemiUnitRegistry
        tags:
            - phpstan.resultCacheMetaExtension
    -
        class: jbboehr\Yumemi\PHPStan\UnitTypeNodeResolverExtension
        tags:
            - phpstan.phpDoc.typeNodeResolverExtension
    -
        class: jbboehr\Yumemi\PHPStan\UnitOperatorTypeSpecifyingExtension
        tags:
            - phpstan.broker.operatorTypeSpecifyingExtension
    -
        class: jbboehr\Yumemi\PHPStan\UnitUnaryOperatorTypeSpecifyingExtension
        tags:
            - phpstan.broker.unaryOperatorTypeSpecifyingExtension
    -
        class: jbboehr\Yumemi\PHPStan\UnitFunctionDynamicReturnTypeExtension
        tags:
            - phpstan.broker.dynamicFunctionReturnTypeExtension
    -
        class: jbboehr\Yumemi\PHPStan\UnitFactorFunctionDynamicReturnTypeExtension
        arguments:
            parser: @yumemiUnitExpressionParser
            units: @yumemiUnits
        tags:
            - phpstan.broker.dynamicFunctionReturnTypeExtension
    -
        class: jbboehr\Yumemi\PHPStan\UnitToFunctionDynamicReturnTypeExtension
        arguments:
            parser: @yumemiUnitExpressionParser
            units: @yumemiUnits
        tags:
            - phpstan.broker.dynamicFunctionReturnTypeExtension
    -
        class: jbboehr\Yumemi\PHPStan\InvalidUnitCallRule
        tags:
            - phpstan.rules.rule
    -
        class: jbboehr\Yumemi\PHPStan\UnitsQuantityReturnTypeExtension
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension
    -
        class: jbboehr\Yumemi\PHPStan\QuantityMethodReturnTypeExtension
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension
    -
        class: jbboehr\Yumemi\PHPStan\PointQuantityMethodReturnTypeExtension
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension
    -
        class: jbboehr\Yumemi\PHPStan\InvalidPointQuantityMethodRule
        tags:
            - phpstan.rules.rule
    -
        class: jbboehr\Yumemi\PHPStan\InvalidQuantityArithmeticRule
        tags:
            - phpstan.rules.rule
    -
        class: jbboehr\Yumemi\PHPStan\InvalidQuantityComparisonRule
        tags:
            - phpstan.rules.rule
    -
        class: jbboehr\Yumemi\PHPStan\InvalidQuantityConstructionRule
        tags:
            - phpstan.rules.rule
    -
        class: jbboehr\Yumemi\PHPStan\InvalidQuantityConversionRule
        tags:
            - phpstan.rules.rule
