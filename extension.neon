# IMM PHPStan extension (incremental).
# Piece 1: unit expression parsing
# Piece 2: unit_int / unit_float PHPDoc types
# Piece 3: arithmetic operator type inference (+ - * / ** % and unary +/-)
# Piece 4: unit() construction helper (dynamic return type)
# Piece 5: unit_to() conversion helper (dynamic return type)
# Piece 6: invalid unit() / unit_to() call diagnostics (rule)

services:
    -
        class: jbboehr\IudexMensurarumMysteriorum\PHPStan\UnitExpressionParser
    -
        class: jbboehr\IudexMensurarumMysteriorum\PHPStan\UnitTypeNodeResolverExtension
        tags:
            - phpstan.phpDoc.typeNodeResolverExtension
    -
        class: jbboehr\IudexMensurarumMysteriorum\PHPStan\UnitOperatorTypeSpecifyingExtension
        tags:
            - phpstan.broker.operatorTypeSpecifyingExtension
    -
        class: jbboehr\IudexMensurarumMysteriorum\PHPStan\UnitUnaryOperatorTypeSpecifyingExtension
        tags:
            - phpstan.broker.unaryOperatorTypeSpecifyingExtension
    -
        class: jbboehr\IudexMensurarumMysteriorum\PHPStan\UnitFunctionDynamicReturnTypeExtension
        tags:
            - phpstan.broker.dynamicFunctionReturnTypeExtension
    -
        class: jbboehr\IudexMensurarumMysteriorum\PHPStan\UnitToFunctionDynamicReturnTypeExtension
        tags:
            - phpstan.broker.dynamicFunctionReturnTypeExtension
    -
        class: jbboehr\IudexMensurarumMysteriorum\PHPStan\InvalidUnitCallRule
        tags:
            - phpstan.rules.rule
