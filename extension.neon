# Yumemi PHPStan extension (incremental).
# Piece 1: unit expression parsing
# Piece 2: unit_int / unit_float PHPDoc types
# Piece 3: arithmetic operator type inference (+ - * / ** % and unary +/-)
# Piece 4: unit() construction helper (dynamic return type)
# Piece 5: unit_to() conversion helper (dynamic return type)
# Piece 6: invalid unit() / unit_to() call diagnostics (rule)
# Piece 7: Quantity<'...'> object type + Units::quantity() return type
# Piece 8: extension-optional @yumemi-* annotations (graceful degradation)

services:
    -
        class: jbboehr\Yumemi\PHPStan\UnitExpressionParser
    -
        class: jbboehr\Yumemi\PHPStan\UnitTypeNodeResolverExtension
        tags:
            - phpstan.phpDoc.typeNodeResolverExtension
    -
        class: jbboehr\Yumemi\PHPStan\UnitOperatorTypeSpecifyingExtension
        tags:
            - phpstan.broker.operatorTypeSpecifyingExtension
    -
        class: jbboehr\Yumemi\PHPStan\UnitUnaryOperatorTypeSpecifyingExtension
        tags:
            - phpstan.broker.unaryOperatorTypeSpecifyingExtension
    -
        class: jbboehr\Yumemi\PHPStan\UnitFunctionDynamicReturnTypeExtension
        tags:
            - phpstan.broker.dynamicFunctionReturnTypeExtension
    -
        class: jbboehr\Yumemi\PHPStan\UnitToFunctionDynamicReturnTypeExtension
        tags:
            - phpstan.broker.dynamicFunctionReturnTypeExtension
    -
        class: jbboehr\Yumemi\PHPStan\InvalidUnitCallRule
        tags:
            - phpstan.rules.rule
    -
        class: jbboehr\Yumemi\PHPStan\UnitsQuantityReturnTypeExtension
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension
    -
        class: jbboehr\Yumemi\PHPStan\QuantityMethodReturnTypeExtension
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension
    -
        class: jbboehr\Yumemi\PHPStan\YumemiDocTagReader
    -
        class: jbboehr\Yumemi\PHPStan\YumemiReturnTagFunctionReturnTypeExtension
        tags:
            - phpstan.broker.dynamicFunctionReturnTypeExtension
    -
        class: jbboehr\Yumemi\PHPStan\YumemiParamTagRule
        tags:
            - phpstan.rules.rule
