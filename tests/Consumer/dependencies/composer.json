{
    "name": "jbboehr/yumemi-consumer-dependencies",
    "description": "External dependency closure for Yumemi's isolated Nix consumer checks.",
    "type": "project",
    "license": "AGPL-3.0-only WITH romic-exception",
    "require": {
        "doctrine/lexer": "^3.0",
        "mjaschen/phpgeo": "^6.0.4",
        "symfony/polyfill-php84": "^1.34"
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2.5"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "prefer-stable": true
}
