#!/usr/bin/env bash

set -euo pipefail

FIXTURES_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
readonly FIXTURES_DIR
PROJECT_ROOT=$(cd -- "$FIXTURES_DIR/../.." && pwd)
readonly PROJECT_ROOT
readonly PACKAGE_MODE=${1:-source}
readonly FIXTURE_SUITE=${2:-core}
readonly FRAMEWORK_MAJOR=${3:-}

WORK_DIR=$(mktemp -d "${TMPDIR:-/tmp}/yumemi-consumer.XXXXXXXX")
readonly WORK_DIR
trap 'rm -rf -- "$WORK_DIR"' EXIT

package_dir=$PROJECT_ROOT

if [[ $PACKAGE_MODE == archive ]]; then
    archive_dir=$WORK_DIR/archive
    package_dir=$WORK_DIR/package
    mkdir -p -- "$archive_dir" "$package_dir"

    composer --working-dir="$PROJECT_ROOT" archive --format=tar --dir="$archive_dir" --no-interaction

    archives=("$archive_dir"/*.tar)
    if [[ ${#archives[@]} -ne 1 || ! -f ${archives[0]} ]]; then
        printf 'Expected exactly one Composer archive in %s.\n' "$archive_dir" >&2
        exit 1
    fi

    tar -xf "${archives[0]}" -C "$package_dir"

    required_paths=(
        composer.json
        data/udunits2.php
        docs/LICENSE_EXCEPTION.md
        docs/UDUNITS-COPYRIGHT
        docs/pages/images/yumemi-banner.png
        extension.neon
        src/Parser/Parser.php
        stubs/illuminate-cache.stub
        yumemi-tags.neon
    )
    for path in "${required_paths[@]}"; do
        if [[ ! -e $package_dir/$path ]]; then
            printf 'Composer archive is missing required path %s.\n' "$path" >&2
            exit 1
        fi
    done

    excluded_paths=(
        .direnv
        .github
        .idea
        .phpbench
        .phpunit.cache
        src/Catalog/PhpCatalogExporter.php
        src/Catalog/Udunits2CatalogImporter.php
        src/Command
        tests
        vendor
    )
    for path in "${excluded_paths[@]}"; do
        if [[ -e $package_dir/$path ]]; then
            printf 'Composer archive contains excluded path %s.\n' "$path" >&2
            exit 1
        fi
    done
elif [[ $PACKAGE_MODE != source ]]; then
    printf 'Usage: %s [source|archive] [core|illuminate-cache] [framework-major]\n' "$0" >&2
    exit 2
fi

# PHP expands $argv; the shell must preserve it literally.
# shellcheck disable=SC2016
repository_json=$(php -r '
echo json_encode([
    "type" => "path",
    "url" => $argv[1],
    "options" => [
        "symlink" => false,
        "versions" => ["jbboehr/yumemi" => "dev-consumer"],
    ],
], JSON_THROW_ON_ERROR);
' "$package_dir")
readonly repository_json

run_core_fixture() {
    local fixture=$1
    local project_dir=$WORK_DIR/$fixture
    local output
    local phpstan=(vendor/bin/phpstan analyse --no-progress --error-format=raw --level=max)

    mkdir -p -- "$project_dir"
    cp -R -- "$FIXTURES_DIR/$fixture/." "$project_dir/"
    cp -R -- "$FIXTURES_DIR/cases" "$project_dir/cases"

    composer --working-dir="$project_dir" repo add yumemi "$repository_json" --no-interaction
    composer --working-dir="$project_dir" update --prefer-dist --no-interaction --no-progress

    if [[ -f $project_dir/phpstan.neon ]]; then
        phpstan+=(--configuration=phpstan.neon)
    fi

    (
        cd -- "$project_dir"
        "${phpstan[@]}" cases/valid.php
    )

    if output=$(
        cd -- "$project_dir"
        "${phpstan[@]}" cases/invalid.php 2>&1
    ); then
        printf '%s consumer PHPStan fixture unexpectedly accepted invalid units.\n' "$fixture" >&2
        exit 1
    fi

    if [[ $output != *"expects unit_float<'meter'>, unit_float<'second'> given"* ]]; then
        printf '%s consumer PHPStan fixture reported an unexpected diagnostic:\n%s\n' "$fixture" "$output" >&2
        exit 1
    fi
}

run_core() {
    run_core_fixture automatic
    php "$WORK_DIR/automatic/runtime.php"
    run_core_fixture manual
}

run_illuminate_cache() {
    local project_dir=$WORK_DIR/illuminate-cache
    local documentation_case=$project_dir/cases/documentation-invalid.php
    local documentation_diagnostic="RateLimiter::hit() expects DateInterval|DateTimeInterface|unit_int<'second'>, unit_int<'minute'> given"
    local output
    local expected_diagnostics=(
        "expects unit_int<'second'>, int given"
        "expects unit_int<'second'>, unit_int<'meter'> given"
        "Illuminate\\Contracts\\Cache\\Repository::put() expects DateInterval|DateTimeInterface|unit_int<'second'>|null, int given"
        "Illuminate\\Contracts\\Cache\\Repository::put() expects DateInterval|DateTimeInterface|unit_int<'second'>|null, unit_int<'minute'> given"
        "Illuminate\\Cache\\Repository::put() expects DateInterval|DateTimeInterface|unit_int<'second'>|null, int given"
        "Illuminate\\Cache\\Repository::put() expects DateInterval|DateTimeInterface|unit_int<'second'>|null, unit_int<'minute'> given"
        "Repository::setDefaultCacheTime() expects unit_int<'second'>|null, int given"
        "RateLimiter::hit() expects DateInterval|DateTimeInterface|unit_int<'second'>, int given"
        "RateLimiter::hit() expects DateInterval|DateTimeInterface|unit_int<'second'>, unit_int<'minute'> given"
        "expects unit_int<'1/1000 * second'>, unit_int<'second'> given"
        "expects unit_int<'minute'>, unit_int<'second'> given"
    )
    local phpstan=(vendor/bin/phpstan analyse --no-progress --error-format=raw --configuration=phpstan.neon)

    if [[ ! $FRAMEWORK_MAJOR =~ ^(11|12|13)$ ]]; then
        printf 'Illuminate Cache consumer tests require framework major 11, 12, or 13.\n' >&2
        exit 2
    fi

    mkdir -p -- "$project_dir"
    cp -R -- "$FIXTURES_DIR/illuminate-cache/." "$project_dir/"

    composer --working-dir="$project_dir" repo add yumemi "$repository_json" --no-interaction
    composer --working-dir="$project_dir" require --dev "illuminate/cache:^$FRAMEWORK_MAJOR.0" --no-update --no-interaction
    composer --working-dir="$project_dir" update --prefer-dist --no-interaction --no-progress

    php "$project_dir/verify.php"
    php "$PROJECT_ROOT/tests/Documentation/extract-markdown-example.php" \
        "$PROJECT_ROOT/docs/pages/reference/phpstan.md" illuminate-cache-invalid > "$documentation_case"

    (
        cd -- "$project_dir"
        "${phpstan[@]}" cases/valid.php
    )

    if output=$(
        cd -- "$project_dir"
        "${phpstan[@]}" cases/invalid.php 2>&1
    ); then
        printf 'Illuminate Cache consumer PHPStan fixture unexpectedly accepted invalid units.\n' >&2
        exit 1
    fi

    for diagnostic in "${expected_diagnostics[@]}"; do
        if [[ $output != *"$diagnostic"* ]]; then
            printf 'Illuminate Cache consumer PHPStan fixture missed diagnostic %s:\n%s\n' "$diagnostic" "$output" >&2
            exit 1
        fi
    done

    if output=$(
        cd -- "$project_dir"
        "${phpstan[@]}" cases/documentation-invalid.php 2>&1
    ); then
        printf 'Illuminate Cache documentation example unexpectedly passed PHPStan.\n' >&2
        exit 1
    fi

    if [[ $output != *"$documentation_diagnostic"* ]]; then
        printf 'Illuminate Cache documentation example reported an unexpected diagnostic:\n%s\n' "$output" >&2
        exit 1
    fi
}

case $FIXTURE_SUITE in
    core)
        run_core
        ;;
    illuminate-cache)
        run_illuminate_cache
        ;;
    *)
        printf 'Usage: %s [source|archive] [core|illuminate-cache] [framework-major]\n' "$0" >&2
        exit 2
        ;;
esac

printf '%s consumer package smoke tests passed using the %s package.\n' "$FIXTURE_SUITE" "$PACKAGE_MODE"
