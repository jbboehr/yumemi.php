{
    source: {
        directories: [
            "src",
        ],
        excludes: [
            "PHPStan",
            "Parser/Parser.php",
        ],
    },
    timeout: 60,
    threads: "max",
    logs: {
        text: "infection.log",
        summary: "infection-summary.log",
    },
    testFramework: "phpunit",
    mutators: {
        "@default": true,
    },
}
