<?php

namespace Illuminate\Contracts\Cache;

interface Repository
{
    /**
     * @param \DateTimeInterface|\DateInterval|int|null $ttl
     * @phpstan-param unit_int<'second'>|\DateTimeInterface|\DateInterval|null $ttl
     * @yumemi-param unit_int<'second'>|\DateTimeInterface|\DateInterval|null $ttl
     */
    public function put($key, $value, $ttl = null);

    /**
     * @param \DateTimeInterface|\DateInterval|int|null $ttl
     * @phpstan-param unit_int<'second'>|\DateTimeInterface|\DateInterval|null $ttl
     * @yumemi-param unit_int<'second'>|\DateTimeInterface|\DateInterval|null $ttl
     */
    public function add($key, $value, $ttl = null);

    /**
     * @param \DateTimeInterface|\DateInterval|\Closure|int|null $ttl
     * @phpstan-param unit_int<'second'>|\DateTimeInterface|\DateInterval|\Closure|null $ttl
     * @yumemi-param unit_int<'second'>|\DateTimeInterface|\DateInterval|\Closure|null $ttl
     */
    public function remember($key, $ttl, \Closure $callback);
}

interface Store
{
    /**
     * @param int $seconds
     * @yumemi-param unit_int<'second'> $seconds
     */
    public function put($key, $value, $seconds);

    /**
     * @param int $seconds
     * @yumemi-param unit_int<'second'> $seconds
     */
    public function putMany(array $values, $seconds);
}

interface Lock
{
    /**
     * @param int $seconds
     * @yumemi-param unit_int<'second'> $seconds
     */
    public function block($seconds, $callback = null);
}

interface LockProvider
{
    /**
     * @param int $seconds
     * @yumemi-param unit_int<'second'> $seconds
     */
    public function lock($name, $seconds = 0, $owner = null);
}

